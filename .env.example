# Frontend (Vite — kun safe-to-expose public verdier)
VITE_SITE_URL=https://sjekksynlighet.no

# Backend (Vercel serverless — api/scan.ts)
# Sett disse i Vercel Dashboard → Project Settings → Environment Variables
RESEND_API_KEY=
SUPABASE_URL=https://bhwzzzzqxhejuqfpzejd.supabase.co
# Anon-key (ikke service_role) — INSERT-rettigheten håndheves via
# RLS-policy "anon insert leads" på synlighet_leads-tabellen.
SUPABASE_ANON_KEY=
CONTACT_FROM_EMAIL="Sjekksynlighet <noreply@sjekksynlighet.no>"
# Salt for IP-hashing i rate-limit. Hvilken som helst tilfeldig
# streng — bare ikke endre den i produksjon (vil resette rate-limit).
IP_HASH_SALT=
# Hvem som får intern lead-notifikasjon når noen kjører en sjekk.
# Komma-separert for flere mottakere. Default: post@medcom.no.
LEAD_NOTIFICATION_EMAIL=post@medcom.no
